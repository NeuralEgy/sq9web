# Square9 website - environment template. Copy to .env.local and fill in.
# The site writes visit bookings into the SAME database the WhatsApp agent uses,
# so staff see website and WhatsApp bookings in one place.

# Database user is NOT decided yet - see README "open questions".
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/square9_agent

# Public site origin, used for canonical URLs, sitemap and hreflang.
NEXT_PUBLIC_SITE_URL=https://square9.eg
