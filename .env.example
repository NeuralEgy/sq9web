# Square9 website - environment template. Copy to .env.local and fill in.
#
# The site writes visit bookings into the SAME database the WhatsApp agent
# uses (square9_agent, table "visits", source='website'), so staff see
# website and WhatsApp bookings in one place.
#
# Use the least-privileged role: sq9_site, which may only INSERT into
# visits. Create it with db/role-site.sql before setting this.
# Do NOT reuse sq9_portal here - it can read every table.
DATABASE_URL=postgresql://sq9_site:PASSWORD@127.0.0.1:5432/square9_agent

# Public site origin, used for canonical URLs, sitemap and hreflang.
NEXT_PUBLIC_SITE_URL=https://square9.eg
